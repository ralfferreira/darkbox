# Local development configuration. Copy to .env and export before running.
DATABASE_URL=postgres://darkbox:darkbox@127.0.0.1:5433/darkbox
DARKBOX_BLOB_ROOT=./data/objects
DARKBOX_REPO_ROOT=.
DARKBOX_LAB_URL=http://127.0.0.1:8080
DARKBOX_INLINE_WORKER=1
# Use .venv/bin/python after installing adapters/browser-python/requirements.txt
DARKBOX_ADAPTER_PYTHON=.venv/bin/python
DARKBOX_BROWSER_MODE=auto
LAB_ALICE_PASSWORD=alice-lab-pass
LAB_BOB_PASSWORD=bob-lab-pass
# Optional OpenAI-compatible provider. Memory synthesis is deterministic without it.
# DARKBOX_MODEL_API_KEY=
# DARKBOX_MODEL_BASE_URL=https://api.openai.com/v1
# DARKBOX_MODEL=gpt-4.1-mini

# Optional: Nmap is detected from PATH. Firecrawl can use REST or hosted MCP.
# DARKBOX_FIRECRAWL_API_KEY=fc-357d78cb505d4945ade4c2f55be22270
# DARKBOX_FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp-oauth
# DARKBOX_FIRECRAWL_MCP_TOKEN=
# DARKBOX_BURP_MCP_URL=http://127.0.0.1:9876
# DARKBOX_BURP_MCP_TOKEN=


# Agent service (apps/agent)
DARKBOX_MODEL_API_KEY=
DARKBOX_MODEL_BASE_URL=https://api.openai.com/v1
DARKBOX_MODEL=your-tool-calling-model
# DARKBOX_AGENT_URL=http://127.0.0.1:8790
# DARKBOX_AGENT_PORT=8790
# DARKBOX_AGENT_HOST=127.0.0.1
# Deterministic browser test driver over the real browser operations.
# It is labelled in the run and is not a model.
# DARKBOX_AGENT_PLANNER=deterministic
# DARKBOX_MODEL=deterministic-planner
# VITE_AGENT_URL=http://127.0.0.1:8790
# Optional cost reservation, micros per million tokens
# DARKBOX_MODEL_INPUT_MICROS_PER_MTOK=0
# DARKBOX_MODEL_OUTPUT_MICROS_PER_MTOK=0
