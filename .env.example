# Local development configuration. Copy to .env and export before running.
DATABASE_URL=postgres://darkbox:darkbox@127.0.0.1:5433/darkbox
DARKBOX_BLOB_ROOT=./data/objects
DARKBOX_REPO_ROOT=.
DARKBOX_LAB_URL=http://127.0.0.1:8080
DARKBOX_INLINE_WORKER=1
DARKBOX_ADAPTER_PYTHON=python3
DARKBOX_BROWSER_MODE=mock
LAB_ALICE_PASSWORD=alice-lab-pass
LAB_BOB_PASSWORD=bob-lab-pass
# Optional OpenAI-compatible provider. Memory synthesis is deterministic without it.
# DARKBOX_MODEL_API_KEY=
# DARKBOX_MODEL_BASE_URL=https://api.openai.com/v1
# DARKBOX_MODEL=gpt-4.1-mini
